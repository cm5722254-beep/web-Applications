# API Base URL — must be accessible from the browser
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay client-only key (rzp_test_* for sandbox)
# Leave blank until provided — checkout button stays disabled
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google AdSense (optional)
NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_AD_UNIT_BANNER=
NEXT_PUBLIC_AD_UNIT_VIDEO_END=

# Default locale
NEXT_PUBLIC_DEFAULT_LOCALE=km
