APP_NAME="CHEATZ ANIME"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Phnom_Penh

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ───────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cheatz_anime
DB_USERNAME=cheatz
DB_PASSWORD=

# Testing database (separate from development)
DB_TEST_DATABASE=cheatz_anime_testing

# ─── Cache & Sessions ───────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ─── Cache ──────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=cheatz

# ─── Mail ───────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@cheatz.anime"
MAIL_FROM_NAME="CHEATZ ANIME"

# ─── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# ─── Sanctum ────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# ─── Storage ────────────────────────────────────────────────────────────────────
# Options: local | s3
SUBTITLE_DISK=local
SUBTITLE_MAX_SIZE_KB=2048

# AWS S3 (optional, for production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Payment (Razorpay) ─────────────────────────────────────────────────────────
PAYMENT_PROVIDER=razorpay
# Use rzp_test_* keys for sandbox testing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Content Providers ──────────────────────────────────────────────────────────
# Configure one or more licensed content providers.
# Leave blank until credentials are obtained from the provider.
CONTENT_PROVIDER_PRIMARY=
CONTENT_PROVIDER_API_KEY=
CONTENT_PROVIDER_API_URL=

# ─── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=10

# ─── Ads (optional) ─────────────────────────────────────────────────────────────
ADS_ENABLED=false
AD_UNIT_BANNER=
AD_UNIT_VIDEO_END=
AD_UNIT_REWARD=
